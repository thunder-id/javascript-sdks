{
  "name": "@thunderid/playground-nuxt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playground for exercising every @thunderid/nuxt capability, client and server, against a local ThunderID server.",
  "scripts": {
    "dev": "nuxt dev --port 3002",
    "build": "nuxt typecheck && nuxt build",
    "preview": "nuxt preview --port 3002",
    "typecheck": "nuxt typecheck",
    "lint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache ."
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@thunderid/browser": "workspace:*",
    "@thunderid/nuxt": "workspace:*",
    "@thunderid/vue": "workspace:*",
    "nuxt": "3.21.11",
    "primevue": "^4.5.5",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "catalog:",
    "@thunderid/prettier-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "^3.3.11"
  }
}
