# Base URL of your ThunderID server.
VITE_THUNDERID_BASE_URL=https://localhost:8090

# Client ID of the application registered in ThunderID (a public SPA client).
VITE_THUNDERID_CLIENT_ID=

# Optional: ID of the same application. Needed for the app-native (embedded) sign-in, sign-up,
# and recovery flows rendered by <SignIn />, <SignUp />, and <Recovery />.
VITE_THUNDERID_APPLICATION_ID=

# Where ThunderID sends the user after sign-in and sign-out. Register both as redirect URIs.
VITE_THUNDERID_AFTER_SIGN_IN_URL=http://localhost:5173
VITE_THUNDERID_AFTER_SIGN_OUT_URL=http://localhost:5173

# Space separated scopes requested at sign-in.
VITE_THUNDERID_SCOPES=openid profile email

# Optional: resource server identifier (RFC 8707 resource indicator) the access token is issued for.
# Needed when the server has no default resource server; sign-in otherwise fails with invalid_target.
# For a local ThunderID server, the System resource server is https://localhost:8090/mcp.
VITE_THUNDERID_RESOURCE=

# Optional: token storage. One of sessionStorage, localStorage, browserMemory. Unset uses the SDK default.
VITE_THUNDERID_STORAGE=


# Optional: per-collection management endpoint overrides (users, user types, groups, roles, agents,
# agent types, applications, flows), passed to <ThunderIDProvider endpoints />. Each is the full
# collection URL; a single item is `{url}/{id}`. Unset, a collection resolves to
# VITE_THUNDERID_BASE_URL/{collection}.
VITE_THUNDERID_ENDPOINT_USERS=
VITE_THUNDERID_ENDPOINT_USER_TYPES=
VITE_THUNDERID_ENDPOINT_GROUPS=
VITE_THUNDERID_ENDPOINT_ROLES=
VITE_THUNDERID_ENDPOINT_AGENTS=
VITE_THUNDERID_ENDPOINT_AGENT_TYPES=
VITE_THUNDERID_ENDPOINT_APPLICATIONS=
VITE_THUNDERID_ENDPOINT_FLOWS=
