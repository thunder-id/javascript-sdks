# Base URL of your ThunderID server.
NEXT_PUBLIC_THUNDERID_BASE_URL=https://localhost:8090

# Redirect sign-in: client ID and secret of a confidential (server-side) application registered in
# ThunderID. Register http://localhost:3001 as a redirect URI.
NEXT_PUBLIC_THUNDERID_CLIENT_ID=
THUNDERID_CLIENT_SECRET=

# App-native (embedded) sign-in, sign-up, and the flow metadata: ID of the same application, and the
# Flow Secret shown when the application was created. The secret is server-only.
NEXT_PUBLIC_THUNDERID_APPLICATION_ID=
THUNDERID_FLOW_SECRET=

# Where ThunderID sends the user after sign-in and sign-out. Unset uses the app origin.
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_IN_URL=http://localhost:3001
NEXT_PUBLIC_THUNDERID_AFTER_SIGN_OUT_URL=http://localhost:3001

# Optional: space separated scopes requested at sign-in. Unset uses the SDK default.
NEXT_PUBLIC_THUNDERID_SCOPES=openid profile email

# Optional: send <SignInButton /> and protectRoute() to the playground's app-native sign-in page
# instead of the ThunderID hosted page.
# NEXT_PUBLIC_THUNDERID_SIGN_IN_URL=/signin

# Optional, playground only: per-collection management endpoint overrides, each a full collection
# URL. Unset, a collection resolves to NEXT_PUBLIC_THUNDERID_BASE_URL/{path}. The SDK reads no
# variable for `endpoints`; src/app/layout.tsx turns these into the `endpoints` prop of
# ThunderIDProvider. The management server action only forwards requests to these URLs. APPLICATIONS
# is not listed: the SDK's management relay (MANAGEMENT_COLLECTIONS in @thunderid/node) does not
# forward it.
# THUNDERID_ENDPOINT_GROUPS=https://localhost:8091/groups
# THUNDERID_ENDPOINT_ROLES=https://localhost:8091/roles
# THUNDERID_ENDPOINT_AGENT_TYPES=https://localhost:8091/agent-types
# THUNDERID_ENDPOINT_AGENTS=https://localhost:8091/agents
# THUNDERID_ENDPOINT_USERS=https://localhost:8091/users
# THUNDERID_ENDPOINT_USER_TYPES=https://localhost:8091/user-types

# Secret that signs the session cookie. Generate one with `openssl rand -base64 32`. Unset uses a
# development default and logs a warning.
THUNDERID_SECRET=

# Local development only: accept the self-signed certificate of a local ThunderID server. This turns
# off TLS verification for every request the Next.js server makes. Never set it in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
