{
  "name": "@thunderid/playground-nextjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playground for exercising every @thunderid/nextjs capability, client and server, against a local ThunderID server.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "lint:fix": "eslint . --fix --ext .js,.jsx,.ts,.tsx,.cjs,.mjs",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.29.5",
    "@thunderid/browser": "workspace:*",
    "@thunderid/nextjs": "workspace:*",
    "@thunderid/react": "workspace:*",
    "next": "15.5.25",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@thunderid/eslint-plugin": "catalog:",
    "@thunderid/prettier-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
